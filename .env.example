# Optional, owner-supplied TomTom Routing API key.
# Register with TomTom before enabling provider queries; usage may be billed.
# Copy to .env, never commit .env (already in .gitignore).
TOMTOM_API_KEY=
# Research subprocess cap. Each process runs a full independent SUMO engine.
# Start with 2 on an 8 GB Mac, increase only if memory permits.
ROME_RESEARCH_MAX_WORKERS=4

# Self-host the 3D renderer so users do not need a separate browser CDN.
FROM node:22-alpine AS frontend
WORKDIR /vendor
RUN npm install --no-audit --no-fund --no-package-lock three@0.165.0

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends sumo sumo-tools \
    && rm -rf /var/lib/apt/lists/*
ENV SUMO_HOME=/usr/share/sumo
RUN test -f "$SUMO_HOME/data/typemap/osmNetconvert.typ.xml"
WORKDIR /service
COPY pyproject.toml README.md ./
COPY app ./app
COPY scripts ./scripts
COPY --from=frontend /vendor/node_modules/three/build/ /service/app/static/vendor/
COPY --from=frontend /vendor/node_modules/three/examples/jsm/controls/OrbitControls.js /service/app/static/vendor/addons/controls/OrbitControls.js
RUN pip install --no-cache-dir ".[sumo]"
RUN mkdir -p data/raw data/sumo data/cache
EXPOSE 8000
CMD ["uvicorn","app.api:app","--host","0.0.0.0","--port","8000"]

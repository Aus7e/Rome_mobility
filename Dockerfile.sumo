# Complete scientific mode: installs SUMO binaries, TraCI, sumolib & FastAPI.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends sumo sumo-tools \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /service
COPY pyproject.toml README.md ./
COPY app ./app
COPY scripts ./scripts
RUN pip install --no-cache-dir ".[sumo]"
RUN mkdir -p data/raw data/sumo data/cache
EXPOSE 8000
CMD ["uvicorn","app.api:app","--host","0.0.0.0","--port","8000"]
